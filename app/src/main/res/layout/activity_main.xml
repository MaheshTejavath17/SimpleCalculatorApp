<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F3F5F9">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Simple Calculator"
            android:textColor="#17233C"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enter two numbers and choose an operation"
            android:textColor="#69758A"
            android:textSize="14sp"
            android:layout_marginBottom="28dp" />

        <EditText
            android:id="@+id/firstNumber"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="First number"
            android:inputType="numberDecimal|numberSigned"
            android:padding="14dp"
            android:background="@drawable/input_background"
            android:textColor="#17233C"
            android:textColorHint="#8993A5"
            android:layout_marginBottom="14dp" />

        <EditText
            android:id="@+id/secondNumber"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Second number"
            android:inputType="numberDecimal|numberSigned"
            android:padding="14dp"
            android:background="@drawable/input_background"
            android:textColor="#17233C"
            android:textColorHint="#8993A5"
            android:layout_marginBottom="24dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <Button
                android:id="@+id/addButton"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="1"
                android:text="+  Add"
                android:textSize="16sp"
                android:textAllCaps="false"
                android:layout_marginEnd="8dp"
                android:backgroundTint="#315EFB" />

            <Button
                android:id="@+id/subtractButton"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="1"
                android:text="−  Subtract"
                android:textSize="16sp"
                android:textAllCaps="false"
                android:layout_marginStart="8dp"
                android:backgroundTint="#315EFB" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/multiplyButton"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="1"
                android:text="×  Multiply"
                android:textSize="16sp"
                android:textAllCaps="false"
                android:layout_marginEnd="8dp"
                android:backgroundTint="#315EFB" />

            <Button
                android:id="@+id/divideButton"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="1"
                android:text="÷  Divide"
                android:textSize="16sp"
                android:textAllCaps="false"
                android:layout_marginStart="8dp"
                android:backgroundTint="#315EFB" />
        </LinearLayout>

        <TextView
            android:id="@+id/resultText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Result: —"
            android:textColor="#17233C"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="22dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/result_background" />

        <Button
            android:id="@+id/clearButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Clear"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#E3E8F2"
            android:textColor="#25324A" />

    </LinearLayout>
</ScrollView>
